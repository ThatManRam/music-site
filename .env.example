# Required
MUSIC_APP_USERNAME=ram
MUSIC_APP_PASSWORD_HASH=PASTE_A_WERKZEUG_PASSWORD_HASH_HERE
MUSIC_APP_SECRET_KEY=PASTE_A_LONG_RANDOM_SECRET_HERE

# LAN binding for direct testing:
MUSIC_BIND=0.0.0.0
MUSIC_PORT=5000

# Set to 1 only when serving the application over HTTPS.
MUSIC_COOKIE_SECURE=0

# Persistent application state. This should be writable by the service user.
MUSIC_STATE_DIR=/var/lib/music-downloader

# Optional: authenticated YouTube cookies for age-restricted/account-required videos.
# Keep this file private and never commit it.
MUSIC_YOUTUBE_COOKIE_FILE="cookies.txt"

# Playlist concurrency (1-8). Single-track downloads remain sequential.
MUSIC_MAX_PARALLEL_DOWNLOADS="3"

# Maximum playlist entries to process (1-5000).
MUSIC_MAX_PLAYLIST_ITEMS="5000"

# YouTube playlist recovery when yt-dlp receives fewer entries than YouTube reports.
MUSIC_PLAYLIST_RECOVERY_BATCH_SIZE="250"
MUSIC_MAX_PLAYLIST_RECOVERY_REQUESTS="20"
