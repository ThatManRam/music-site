MUSIC_APP_USERNAME=ram
MUSIC_APP_PASSWORD_HASH=PASTE_HASH_HERE
MUSIC_APP_SECRET_KEY=PASTE_SECRET_HERE
MUSIC_BIND=0.0.0.0
MUSIC_PORT=5000
MUSIC_COOKIE_SECURE=0
MUSIC_STATE_DIR=/var/lib/music-downloader

# Music directories. Use colon-separated paths; the first drive with enough free space is selected.
MUSIC_PATHS="/mnt/CENMATE_250GB/music:/mnt/CENMATE_640GB/music"

# Read the live Firefox/Chromium browser cookie database as the service user.
# For Firefox, leaving the profile blank matches --cookies-from-browser firefox.
MUSIC_YOUTUBE_BROWSER="firefox"
MUSIC_YOUTUBE_BROWSER_PROFILE=""
MUSIC_YOUTUBE_BROWSER_CONTAINER=""
MUSIC_DENO_PATH="/home/pi/.deno/bin/deno"


MUSIC_MAX_PLAYLIST_ITEMS="5000"
MUSIC_PLAYLIST_RECOVERY_BATCH_SIZE="250"
MUSIC_MAX_PLAYLIST_RECOVERY_REQUESTS="20"
